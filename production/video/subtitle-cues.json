[
  {
    "start": 0.2,
    "end": 6.24,
    "text": "先看效果。通透海床、像素折射和交互涟漪，都在Godot里实时运行。",
    "shot": "intro_day"
  },
  {
    "start": 8.2,
    "end": 12.239999999999998,
    "text": "落点汇流向外传播，夜间保留冷暖反光。",
    "shot": "intro_night"
  },
  {
    "start": 14.2,
    "end": 16.96,
    "text": "入水越深，角色水线越高。",
    "shot": "intro_immersion"
  },
  {
    "start": 18.2,
    "end": 21.34,
    "text": "底图负责材质，数据负责空间。",
    "shot": "semantic"
  },
  {
    "start": 21.439999999999998,
    "end": 24.979999999999997,
    "text": "四个通道是水域、距岸、水深和可走。",
    "shot": "semantic"
  },
  {
    "start": 27.2,
    "end": 31.72,
    "text": "先画水面和瀑布，再画倒影、角色与前景。",
    "shot": "stack"
  },
  {
    "start": 31.82,
    "end": 34.42,
    "text": "每层只承担自己的视觉线索。",
    "shot": "stack"
  },
  {
    "start": 36.2,
    "end": 38.540000000000006,
    "text": "正弦波扰动采样位置。",
    "shot": "refraction"
  },
  {
    "start": 38.64,
    "end": 40.9,
    "text": "位移取整，岸外退回。",
    "shot": "refraction"
  },
  {
    "start": 41.0,
    "end": 43.12,
    "text": "水底会动，沙岸不动。",
    "shot": "refraction"
  },
  {
    "start": 46.2,
    "end": 51.580000000000005,
    "text": "浅深色与海床混合。提高清澈度，水下石块保留更多。",
    "shot": "depth"
  },
  {
    "start": 52.2,
    "end": 55.52,
    "text": "正弦函数生成焦散，随深度衰减。",
    "shot": "caustics"
  },
  {
    "start": 58.2,
    "end": 62.1,
    "text": "泡沫沿距岸等值线往复，不必逐段手绘。",
    "shot": "foam"
  },
  {
    "start": 64.2,
    "end": 68.06,
    "text": "点击和移动触发涟漪，扩散时扰动折射。",
    "shot": "ripples"
  },
  {
    "start": 70.2,
    "end": 75.44,
    "text": "双相滚动让水幕下落，落点翻动，汇流波向外衰减。",
    "shot": "falls"
  },
  {
    "start": 78.2,
    "end": 82.9,
    "text": "桥身二维投影，叠加冷暖光带，形成夜间反光。",
    "shot": "environment"
  },
  {
    "start": 84.2,
    "end": 90.28,
    "text": "地图深度决定浸没量，精灵局部高度决定哪些像素入水。",
    "shot": "height"
  },
  {
    "start": 90.38,
    "end": 94.83999999999999,
    "text": "给高度加一条横向曲线，水线就能绕着身体弯曲。",
    "shot": "height"
  },
  {
    "start": 96.2,
    "end": 99.06,
    "text": "水下身体染色、透明并扰动。",
    "shot": "immersion"
  },
  {
    "start": 99.16,
    "end": 103.58,
    "text": "水线用窄亮带，倒影翻转压缩，随浸没变淡。",
    "shot": "immersion"
  },
  {
    "start": 106.2,
    "end": 111.7,
    "text": "比较脚点与接地高度。人在后面画前景，走到前面不覆盖。",
    "shot": "occlusion"
  },
  {
    "start": 114.2,
    "end": 117.86,
