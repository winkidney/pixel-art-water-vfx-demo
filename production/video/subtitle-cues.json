  },
  {
    "start": 117.96000000000001,
    "end": 123.36000000000001,
    "text": "滑杆和数值输入即时生效，改速度时保留当前相位。",
    "shot": "parameters"
  },
  {
    "start": 124.2,
    "end": 128.06,
